[worldserver]
PrestigioHollow.Enable = 1
# Base independiente obligatoria. No se reutilizan credenciales del core.
# Formato: host;puerto;usuario;clave;mod_prestigio_hollow[;ssl]
# Ejemplo local (sustituir usuario y clave en el .conf real, no en Git):
# PrestigioHollow.DatabaseInfo = "127.0.0.1;3306;prestigio_user;TU_CLAVE;mod_prestigio_hollow"
PrestigioHollow.DatabaseInfo = ""
PrestigioHollow.RequiredLevel = 80
PrestigioHollow.AnnounceWorld = 1
# El equipo se guarda siempre en las bolsas; se requiere un hueco por pieza.
# La antigua opción PrestigioHollow.MailEquippedItems ya no se utiliza.
PrestigioHollow.GiveStartingOutfit = 1
PrestigioHollow.PreservePermanentSpells = 1
