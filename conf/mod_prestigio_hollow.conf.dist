[worldserver]
PrestigioHollow.Enable = 1
# La base mod_prestigio_hollow debe estar en la misma instancia MySQL que characters.
# Un trabajador propio usa CharacterDatabaseInfo para guardar ambas bases atomicamente.
# El usuario de characters requiere SELECT, INSERT, UPDATE sobre mod_prestigio_hollow.*.
# La antigua opcion PrestigioHollow.DatabaseInfo ya no se lee.
PrestigioHollow.RequiredLevel = 80
PrestigioHollow.AnnounceWorld = 1
# El equipo va siempre a las bolsas, con un hueco compatible por pieza.
# MailEquippedItems ya no se lee. Al confirmar se vuelve a seleccion de personajes.
PrestigioHollow.GiveStartingOutfit = 1
PrestigioHollow.PreservePermanentSpells = 1
